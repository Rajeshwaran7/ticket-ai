# Azure OpenAI Configuration (via Elsai Model)
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
OPENAI_API_VERSION=2023-05-15
AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name
AZURE_OPENAI_TEMPERATURE=0.1

# Model Configuration
ELSAI_MODEL=gpt-4o-mini
ELSAI_AGENT_TYPE=openai-functions

# Fallback: Direct OpenAI API (optional, for vision API if Azure doesn't support it)
OPENAI_API_KEY=your_openai_api_key_here

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE_MINUTES=1440

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=ticket_ai

# SMTP Configuration (for email notifications)
# For Gmail: Use App Password (not regular password)
# Enable 2FA and generate App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=noreply@ticketing.com
